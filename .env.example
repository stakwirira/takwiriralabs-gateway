# Stable HTTPS URLs of the two real Beamline Vercel projects: the Vite web app
# and the Express API. Configure both in Vercel for this gateway (Production
# and Preview as appropriate), then redeploy. Do not include trailing slashes.
BEAMLINE_ORIGIN=https://your-beamline-web.vercel.app
BEAMLINE_API_ORIGIN=https://your-beamline-api.vercel.app
